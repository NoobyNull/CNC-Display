# clangd config for editor diagnostics only. The build is PlatformIO + the
# xtensa GCC toolchain and is unaffected by anything here.
#
# compile_commands.json is generated by `pio run -e ws7b -t compiledb` and has
# all 352 include paths, but every entry invokes xtensa-esp32s3-elf-g++ with
# flags clang does not recognise. clangd aborts the command on the first unknown
# flag, so it never reaches the -I list and reports every LVGL type as unknown
# and every project header as missing. Stripping them is what makes the database
# usable.
#
# Regenerate after adding libraries or changing build_flags:
#     pio run -e ws7b -t compiledb

CompileFlags:
  # Parse as host C++ rather than xtensa. Mainline clang has no xtensa backend,
  # so there is no target to select; for diagnostics the host ABI is fine
  # because nothing here depends on target word size or layout.
  Remove:
    - -m*                          # -mlongcalls, -mdisable-hardware-atomics, ...
    - -fno-tree-switch-conversion  # GCC optimiser flag, no clang equivalent
    - -fstrict-volatile-bitfields  # GCC-only
    - -free*
    - -fipa*
    - --param=*
  Add:
    - -Wno-unknown-warning-option
    - -Wno-unused-command-line-argument
    # The firmware links newlib, not glibc. Without these clangd falls back to
    # the host's headers, which have no <machine/endian.h> and no
    # __assert_func — so anything reaching Arduino.h or configASSERT() failed to
    # parse. -isystem, not -I, so warnings inside the toolchain stay quiet.
    # Only the C headers are added, not the toolchain's libstdc++: the host one
    # resolves fine and pinning a compiler version here would rot on the next
    # toolchain update.
    - -isystem/home/matthew/.platformio/packages/toolchain-xtensa-esp-elf/xtensa-esp-elf/include

Diagnostics:
  # Deliberately NOT suppressing unknown_typename / pp_file_not_found: those are
  # the errors this file exists to make go away properly, and muting them would
  # also hide a genuinely missing header later.
  UnusedIncludes: None
